# Copy to terraform.tfvars and fill in values.

subscription_id       = "00000000-0000-0000-0000-000000000000"
location              = "eastus"
avd_metadata_location = "eastus"
prefix                = "avdp"

# Host pool
personal_desktop_assignment_type = "Automatic" # or "Direct"
start_vm_on_connect              = true

# Session hosts (one VM per user)
session_host_count = 2
vm_size            = "Standard_D4s_v5"
timezone           = "India Standard Time"

# --- Option A (default): Terraform builds a new AD DS forest + DC ---
deploy_adds              = true
domain_name              = "avdlab.local"
adds_domain_netbios_name = "AVDLAB"
adds_dc_private_ip       = "10.50.0.4"
domain_ou_path           = ""
# Domain join credentials default to admin_username / admin_password.

# --- Option B: join an existing AD DS domain ---
# deploy_adds          = false
# existing_subnet_id   = "/subscriptions/.../resourceGroups/.../providers/Microsoft.Network/virtualNetworks/.../subnets/..."
# domain_name          = "contoso.local"
# domain_ou_path       = "OU=AVD,DC=contoso,DC=local"
# domain_join_username = "joiner@contoso.local"
# domain_join_password = "set-via-TF_VAR_domain_join_password"

# Access: Entra ID object IDs of groups synced from AD DS (via Entra Connect / Cloud Sync)
avd_user_group_object_ids = ["11111111-1111-1111-1111-111111111111"]
